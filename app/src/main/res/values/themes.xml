<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SongKtv" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.SongKtv.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0B1F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SongKtv</item>
    </style>
</resources>
